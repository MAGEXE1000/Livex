# Livex Environment Configuration Template
# Copy this file to .env or .env.local for local development.
# DO NOT commit real secrets or private keys to version control.

# --- Firebase Client SDK Configuration (Public Client Identifiers) ---
VITE_FIREBASE_API_KEY=AIzaSyPlaceholderKeyForDevelopmentOnly12345
VITE_FIREBASE_AUTH_DOMAIN=livex-placeholder.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=livex-placeholder
VITE_FIREBASE_STORAGE_BUCKET=livex-placeholder.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_DATABASE_ID=(default)

# --- OTA Base URL / Release Tracking Endpoint ---
VITE_OTA_BASE_URL=https://studio-30f44.web.app

# --- App Target ('web' | 'android') ---
VITE_APP_TARGET=web

# --- Optional AI Gateway & Localization Services ---
VITE_AI_GATEWAY_URL=
VITE_APP_TOLGEE_API_KEY=
VITE_APP_TOLGEE_API_URL=https://app.tolgee.io
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ==============================================================================
# SERVER-SIDE PRIVATE SECRETS (Cloudflare Pages / Serverless Functions / CI Only)
# ==============================================================================
# CRITICAL SECURITY NOTICE:
# - NEVER prefix server secrets with VITE_.
# - NEVER reference server secrets in frontend code or client bundle configs.
# - Store these variables ONLY in Cloudflare Pages Secrets, Google Cloud Secret
#   Manager, or GitHub Actions encrypted repository secrets.
#
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# OPENAI_COMPATIBLE_API_KEY=your_openai_compatible_key_here
# OPENAI_COMPATIBLE_BASE_URL=https://your-custom-llm-host.com/v1
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
#
# SECRET ROTATION PROCEDURE:
# 1. If any server secret is ever suspected of being exposed or leaked:
#    a. Immediately revoke the active token in the provider console (Google Cloud,
#       Groq, OpenAI, Anthropic, or Firebase IAM).
#    b. Generate a new secret key with minimal scoped permissions.
#    c. Update the secret in Cloudflare Pages dashboard (`npx wrangler pages secret put <KEY>`).
#    d. Trigger a deployment redeploy to inject updated secrets into runtime edge workers.
# 2. No client app release is required for server secret rotations since zero private
#    secrets reside in compiled web or Android client bundles.
# ==============================================================================

