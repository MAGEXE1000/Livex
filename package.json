{
  "name": "workspace",
  "version": "4.5.85",
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"const fs=require('fs');for(const f of ['package-lock.json','yarn.lock'])try{fs.unlinkSync(f)}catch{};const ua=process.env.npm_config_user_agent||'';if(!ua.startsWith('pnpm/')){console.error('Use pnpm instead');process.exit(1)}\"",
    "build": "pnpm lint:imports && pnpm check:references && pnpm check:circular && pnpm check:tokens && pnpm check:hook-order && pnpm check:icons && pnpm check:stage-core && pnpm typecheck:web && pnpm typecheck:android && pnpm build:web && pnpm build:android:web",
    "sync:stage-core": "node scripts/sync-stage-core.mjs",
    "check:stage-core": "node scripts/verify-stage-core-sync.mjs",
    "check:hook-order": "node scripts/check-hook-order.mjs",
    "check:hooks": "node scripts/check-hook-order.mjs",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "check:references": "node scripts/verify-all-references.mjs",
    "check:circular": "node scripts/verify-circular-deps.mjs",
    "dev:web": "pnpm --filter @workspace/studio-web dev",
    "dev:mobile": "node scripts/dev-mobile.mjs",
    "dev:android": "node scripts/dev-android.mjs",
    "dev:preview": "node scripts/dev-preview.mjs",
    "build:web": "pnpm --filter @workspace/studio-web build",
    "build:android:web": "pnpm --filter @workspace/studio-android build",
    "build:android": "pnpm --filter @workspace/studio-android android:build",
    "preview:android": "pnpm --filter @workspace/studio-android preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "typecheck:libs": "tsc --build",
    "typecheck:web": "pnpm run typecheck:libs && pnpm --filter @workspace/studio-web typecheck",
    "typecheck:android": "pnpm run typecheck:libs && pnpm --filter @workspace/studio-android typecheck",
    "test:web": "pnpm --filter @workspace/studio-web test",
    "test:android": "pnpm --filter @workspace/studio-android test",
    "test:core": "pnpm --filter @workspace/studio-core test",
    "test": "pnpm --filter @workspace/studio-core test",
    "sync:versions": "node scripts/sync-versions.mjs",
    "sync:icons": "node scripts/sync-launcher-icons.mjs",
    "check:icons": "node scripts/sync-launcher-icons.mjs --verify",
    "test:icons": "node apps/studio-android/scripts/__tests__/launcher-icons.test.mjs",
    "verify:device": "node scripts/verify-device-runtime-icon.mjs",
    "lint:imports": "node scripts/enforce-import-boundaries.mjs",
    "check:versions": "node scripts/verify-versions-consistency.mjs",
    "scope:check": "node scripts/enforce-platform-scope.mjs",
    "docs:validate": "node scripts/validate-documentation.mjs",
    "test:installer-validator": "node apps/studio-android/scripts/__tests__/validate-app-installer.test.mjs",
    "release:doctor": "node apps/studio-android/scripts/releaseDoctor/index.mjs",
    "test:doctor": "node apps/studio-android/scripts/__tests__/release-doctor.test.mjs",
    "release:dry-run": "node apps/studio-android/scripts/releaseDryRun/index.mjs",
    "release:timeline": "node apps/studio-android/scripts/releaseTimeline/index.mjs",
    "release:lint": "node apps/studio-android/scripts/releaseLint/index.mjs",
    "test:architecture": "node apps/studio-android/scripts/__tests__/release-architecture.test.mjs",
    "release:audit": "node apps/studio-android/scripts/releaseAudit/index.mjs",
    "release:e2e": "node apps/studio-android/scripts/releaseE2E/index.mjs",
    "test:release-e2e": "node apps/studio-android/scripts/__tests__/release-e2e.test.mjs",
    "release:parity": "node apps/studio-android/scripts/releaseParity/index.mjs",
    "test:release-parity": "node apps/studio-android/scripts/__tests__/release-parity.test.mjs",
    "test:groovex-transposition": "node scripts/test-groovex-transposition.mjs"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rollup/rollup-win32-x64-msvc": "^4.63.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-livex": "workspace:*",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "madge": "^8.0.0",
    "prettier": "^3.9.5",
    "puppeteer": "^25.3.0",
    "sharp": "^0.35.4",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.64.0"
  },
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "lucide-animated": "^1.0.5"
  }
}
